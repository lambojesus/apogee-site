{
  "redirects": [
    { "source": "/portfolio", "destination": "/#portfolio", "permanent": true },
    { "source": "/portfolio.html", "destination": "/#portfolio", "permanent": true },
    { "source": "/about", "destination": "/#about", "permanent": true },
    { "source": "/about.html", "destination": "/#about", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true },
    { "source": "/contact.html", "destination": "/#contact", "permanent": true },
    { "source": "/projects/golf-cart-tire-supply", "destination": "/#portfolio", "permanent": true },
    { "source": "/projects/lawn-mower-tire-supply", "destination": "/#portfolio", "permanent": true },
    { "source": "/projects/trex-golf-cart", "destination": "/#portfolio", "permanent": true },
    { "source": "/projects/golf-cart-sellers", "destination": "/#portfolio", "permanent": true },
    { "source": "/projects/:path*", "destination": "/#portfolio", "permanent": true },
    { "source": "/categories/:path*", "destination": "/#portfolio", "permanent": true }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }
      ]
    },
    {
      "source": "/favicon-96.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }
      ]
    },
    {
      "source": "/favicon-192.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }
      ]
    },
    {
      "source": "/favicon-512.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
